{
  "name": "universal-iot-backend",
  "version": "1.0.0",
  "description": "Universal IoT Home App - Mock Server & Device Simulator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "json-server:cli": "json-server db.json --port 3001 --routes routes.json",
